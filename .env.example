# Copiar a .env (ignorado por git) y completar con los valores reales.
# Los valores salen de la respuesta de POST /api/student/register (campo
# "integration") y de GET /api/student/integration. Nunca commitear valores reales.
# Mismo set de variables CATEDRA_* en atlas-catalogo y cronos-turnos.

# --- Cátedra: cuenta técnica ---
CATEDRA_REST_BASE_URL=http://<host>:<puerto>
CATEDRA_ID_TOKEN=<id_token>
CATEDRA_GROUP_ID=<groupId>

# --- Redis (lectura: catedra:sync:*) ---
CATEDRA_REDIS_HOST=<redisHost>
CATEDRA_REDIS_PORT=<redisPort>
CATEDRA_REDIS_USERNAME=<redisUsername>
CATEDRA_REDIS_PASSWORD=<redisPassword>
CATEDRA_REDIS_READ_NAMESPACE=catedra:sync:*
CATEDRA_REDIS_WRITE_NAMESPACE=alumnos:<groupId>:*

# --- Kafka ---
CATEDRA_KAFKA_BOOTSTRAP_SERVERS=<kafkaBootstrapServers>
CATEDRA_KAFKA_CATALOG_TOPIC=catedra.catalog.<groupId>
CATEDRA_KAFKA_CONSUMER_GROUP_ID=alumnos-<groupId>
# Solo si la cátedra exige autenticación en Kafka: activar el perfil con SPRING_PROFILES_ACTIVE=kafka-sasl y
# definir el JAAS (usuario y contraseña) únicamente acá. Sin esto la conexión es PLAINTEXT.
# CATEDRA_KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.plain.PlainLoginModule required username="<usuario>" password="<password>";
CATEDRA_KAFKA_APPOINTMENT_ACTIONS_TOPIC=alumnos.turnos.acciones.<groupId>
CATEDRA_KAFKA_APPOINTMENT_PHONE_TOPIC=catedra.turnos.telefono.<groupId>

# --- Seguridad de la API (atlas-catalogo) ---
# Clave PÚBLICA con la que cronos-turnos firma los JWT (PEM X.509, RSA de 2048 bits o más). Una de las dos.
# Para desarrollo sin cronos-turnos, ver "Probar la API" en el README.
ATLAS_JWT_PUBLIC_KEY_LOCATION=<ruta-a-la-clave-publica.pem>
# ATLAS_JWT_PUBLIC_KEY=<el PEM en una línea, con los saltos de línea como \n>
# ATLAS_CORS_ALLOWED_ORIGINS=https://app.ejemplo.test   # orígenes permitidos, separados por coma; vacío = ninguno
# HTTPS (opcional, variables estándar de Spring Boot; ver "Seguridad" en el README):
# SERVER_SSL_KEY_STORE=<ruta-al-keystore.p12>
# SERVER_SSL_KEY_STORE_PASSWORD=<contraseña-del-almacén>
# SERVER_SSL_KEY_STORE_TYPE=PKCS12

# --- Base de datos local (atlas) ---
ATLAS_DB_HOST=localhost
ATLAS_DB_PORT=5433
ATLAS_DB_NAME=atlas
ATLAS_DB_USER=atlas
ATLAS_DB_PASSWORD=<password>

# --- Sincronización de atlas (opcionales: valores por defecto entre paréntesis) ---
# ATLAS_SYNC_ON_STARTUP=true            # sincroniza al terminar de arrancar
# ATLAS_SYNC_PERIODIC_CHECK=true        # verificación periódica de la versión
# ATLAS_SYNC_CHECK_INTERVAL=60s         # espera entre verificaciones
# ATLAS_SYNC_MAX_VERSIONS_PER_RUN=1000  # versiones máximas por corrida
# ATLAS_SYNC_KAFKA_ENABLED=true         # consumidor del aviso CatalogUpdated
# ATLAS_SEARCH_ENDPOINT=true            # búsqueda de profesionales (ROLE_USER o ROLE_ADMIN)
# ATLAS_SYNC_STATUS_ENDPOINT=true       # estado de la sincronización (solo ROLE_ADMIN)
